<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Font overlays. Besides android:fontFamily they replace android:textViewStyle, because some
         themes (the complete ones) set their own font through that style and would otherwise win. -->
    <style name="Widget.Font1" parent="android:Widget.TextView">
        <item name="android:fontFamily">serif</item>
    </style>
    <style name="Overlay.Font1" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textViewStyle">@style/Widget.Font1</item>
    </style>
